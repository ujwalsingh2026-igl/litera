# LITERIA Firebase & Cloud Sync Environment Configuration
# Copy this file to .env or .env.local and fill in your values from the Firebase Console.
# (Firebase Console -> Project Settings -> General -> Your apps -> Web app)

# Public Firebase Web Client Configuration (Safe for frontend build)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: Firebase Local Emulator Configuration (For offline testing)
# VITE_USE_FIREBASE_EMULATOR=false
# VITE_FIREBASE_AUTH_EMULATOR_URL=http://localhost:9099
# VITE_FIRESTORE_EMULATOR_HOST=localhost
# VITE_FIRESTORE_EMULATOR_PORT=8080

# Android App Configuration:
# - Package Name / Application ID: com.literia.app
# - In Firebase Console, add an Android app with Package Name: com.literia.app
# - Download google-services.json and place it at: android/app/google-services.json
# - Add your Debug and Release SHA-1 / SHA-256 fingerprints to the Android app in Firebase Console.
